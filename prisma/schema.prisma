// Modelo de datos de Tiendix
// Documentación de Prisma: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Organización: sucursales, usuarios y roles
// ─────────────────────────────────────────────

enum Role {
  ADMIN // acceso total
  MANAGER // gestiona inventario, compras y reportes de sus sucursales
  CASHIER // solo caja (ventas) en sus sucursales
}

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique // código corto, p. ej. "CENTRAL"
  name      String
  address   String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          UserBranch[]
  sessions       Session[]
  stock          Stock[]
  stockMovements StockMovement[]
  purchases      Purchase[]
  sales          Sale[]

  @@map("branches")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(CASHIER)
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branches       UserBranch[]
  sessions       Session[]
  stockMovements StockMovement[]
  purchases      Purchase[]
  sales          Sale[]

  @@map("users")
}

// Sucursales a las que tiene acceso cada usuario
model UserBranch {
  userId   String
  branchId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branches")
}

// Sesiones de inicio de sesión. La cookie guarda un token aleatorio;
// aquí solo se guarda su hash (SHA-256), así un volcado de la base no permite
// suplantar a nadie. Borrar la fila cierra la sesión al instante.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  branchId  String? // sucursal activa en esta sesión
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("sessions")
}

// ─────────────────────────────────────────────
// Catálogo: categorías y productos
// ─────────────────────────────────────────────

model Category {
  id        String     @id @default(cuid())
  name      String
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  products  Product[]
  active    Boolean    @default(true) // inactiva = no se ofrece al crear productos
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([parentId, name])
  @@map("categories")
}

enum UnitOfMeasure {
  UNIT // unidad / pieza
  KG
  G
  L
  ML
  M // metro
  BOX // caja / paquete
}

model Product {
  id          String        @id @default(cuid())
  sku         String        @unique // código interno
  name        String
  description String?
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit        UnitOfMeasure @default(UNIT)
  cost        Decimal       @default(0) @db.Decimal(12, 2) // último costo de compra
  price       Decimal       @db.Decimal(12, 2) // precio de venta (con impuesto incluido)
  taxRate     Decimal       @default(0) @db.Decimal(5, 2) // % de impuesto, p. ej. 12.00
  trackStock  Boolean       @default(true) // false para servicios
  minStock    Decimal       @default(0) @db.Decimal(12, 3) // alerta de stock bajo
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  barcodes       ProductBarcode[]
  stock          Stock[]
  stockMovements StockMovement[]
  purchaseItems  PurchaseItem[]
  saleItems      SaleItem[]

  @@index([name])
  @@map("products")
}

// Un producto puede tener varios códigos de barras (EAN-13, UPC, códigos internos, empaques)
model ProductBarcode {
  id        String  @id @default(cuid())
  code      String  @unique
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Cuántas unidades representa este código (p. ej. 12 para un fardo)
  quantity  Decimal @default(1) @db.Decimal(12, 3)

  @@index([productId])
  @@map("product_barcodes")
}

// ─────────────────────────────────────────────
// Inventario
// ─────────────────────────────────────────────

// Existencia actual por producto y sucursal (se actualiza junto con cada movimiento)
model Stock {
  branchId  String
  productId String
  quantity  Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([branchId, productId])
  @@map("stock")
}

enum StockMovementType {
  INITIAL // carga inicial
  PURCHASE // entrada por compra
  SALE // salida por venta
  SALE_RETURN // devolución de cliente
  PURCHASE_RETURN // devolución a proveedor
  ADJUSTMENT // ajuste manual / conteo físico
  TRANSFER_IN // entrada por traslado entre sucursales
  TRANSFER_OUT // salida por traslado entre sucursales
  MANUAL_IN // entrada manual (sin compra registrada)
  MANUAL_OUT // salida manual: merma, daño, consumo interno, etc.
}

// Kardex: historial inmutable de cada entrada y salida
model StockMovement {
  id          String            @id @default(cuid())
  type        StockMovementType
  branchId    String
  productId   String
  quantity    Decimal           @db.Decimal(12, 3) // positivo = entrada, negativo = salida
  unitCost    Decimal?          @db.Decimal(12, 2)
  balance     Decimal?          @db.Decimal(12, 3) // existencia que quedó después del movimiento
  reason      String? // motivo de entradas/salidas/ajustes manuales (ver src/lib/inventory/reasons.ts)
  note        String?
  userId      String?
  purchaseId  String?
  saleId      String?
  transferRef String? // agrupa las dos patas de un traslado
  createdAt   DateTime          @default(now())

  branch   Branch    @relation(fields: [branchId], references: [id])
  product  Product   @relation(fields: [productId], references: [id])
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  sale     Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([branchId, productId, createdAt])
  @@index([createdAt])
  @@map("stock_movements")
}

// ─────────────────────────────────────────────
// Compras
// ─────────────────────────────────────────────

model Supplier {
  id          String     @id @default(cuid())
  name        String
  taxId       String? // NIT / RFC / RUC
  contactName String?
  email       String?
  phone       String?
  address     String?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  purchases   Purchase[]

  @@index([name])
  @@map("suppliers")
}

enum PurchaseStatus {
  DRAFT // orden en preparación
  ORDERED // enviada al proveedor
  RECEIVED // mercadería recibida (genera movimientos de stock)
  CANCELLED
}

model Purchase {
  id            String         @id @default(cuid())
  number        Int            @unique @default(autoincrement())
  supplierId    String
  branchId      String
  userId        String
  status        PurchaseStatus @default(DRAFT)
  invoiceNumber String? // número de factura del proveedor
  subtotal      Decimal        @default(0) @db.Decimal(12, 2)
  tax           Decimal        @default(0) @db.Decimal(12, 2)
  total         Decimal        @default(0) @db.Decimal(12, 2)
  note          String?
  receivedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  supplier       Supplier        @relation(fields: [supplierId], references: [id])
  branch         Branch          @relation(fields: [branchId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
  items          PurchaseItem[]
  stockMovements StockMovement[]

  @@index([branchId, createdAt])
  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Decimal  @db.Decimal(12, 3)
  unitCost   Decimal  @db.Decimal(12, 2)
  total      Decimal  @db.Decimal(12, 2)
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@map("purchase_items")
}

// ─────────────────────────────────────────────
// Ventas (POS)
// ─────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  name      String
  taxId     String? // NIT del cliente para la factura ("CF" = consumidor final)
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]

  @@index([name])
  @@map("customers")
}

enum SaleStatus {
  COMPLETED
  CANCELLED // anulada
  REFUNDED // devuelta total o parcialmente
}

model Sale {
  id         String     @id @default(cuid())
  number     Int        @unique @default(autoincrement())
  branchId   String
  userId     String // cajero
  customerId String?
  status     SaleStatus @default(COMPLETED)
  subtotal   Decimal    @db.Decimal(12, 2)
  discount   Decimal    @default(0) @db.Decimal(12, 2)
  tax        Decimal    @default(0) @db.Decimal(12, 2)
  total      Decimal    @db.Decimal(12, 2)
  note       String?
  // Id generado en el cliente para sincronizar ventas hechas sin conexión (PWA)
  clientId   String?    @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  branch         Branch          @relation(fields: [branchId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items          SaleItem[]
  payments       Payment[]
  stockMovements StockMovement[]

  @@index([branchId, createdAt])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  taxRate   Decimal @default(0) @db.Decimal(5, 2)
  total     Decimal @db.Decimal(12, 2)
  // Costo al momento de la venta, para calcular margen en reportes
  unitCost  Decimal @default(0) @db.Decimal(12, 2)
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@map("sale_items")
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

model Payment {
  id        String        @id @default(cuid())
  saleId    String
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  reference String? // nº de autorización, transferencia, etc.
  createdAt DateTime      @default(now())
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("payments")
}
